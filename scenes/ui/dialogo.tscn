anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 160.0
offset_top = -300.0
offset_right = -160.0
offset_bottom = -40.0
grow_horizontal = 2
grow_vertical = 0
theme_override_styles/panel = SubResource("estilo_caja")

[node name="Margen" type="MarginContainer" parent="Raiz/Caja"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 20

[node name="Contenido" type="VBoxContainer" parent="Raiz/Caja/Margen"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Nombre" type="Label" parent="Raiz/Caja/Margen/Contenido"]
