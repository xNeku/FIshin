[node name="Texto" type="Label" parent="Raiz/Caja/Margen/Contenido"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.1, 0.07, 0.12, 1)
theme_override_constants/outline_size = 0
theme_override_font_sizes/font_size = 32
