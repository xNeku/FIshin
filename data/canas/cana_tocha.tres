[ext_resource type="Script" path="res://scripts/datos/cana_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"cana_tocha"
nombre = "Caña tocha"
descripcion = "Un tronco con carrete de barco. Solo pican raros o mejores, y tardan. Pelea larga en el carril: si la tensión se vacía, se escapa."
modo = 2
profundidad = 6
mult_espera = 1.6
mult_rareza = 3.0
