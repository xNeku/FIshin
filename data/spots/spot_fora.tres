[resource]
script = ExtResource("1_script")
id = &"spot_fora"
nombre = "Mar de Fóra"
descripcion = "El último pantalán del puerto, mirando a mar abierto, sin fondo a la vista. Solo los gigantes: más de 40 kg, raros o mejores, de aquí y de fuera. Pelea larga en el carril: si la tensión se vacía, se escapa. Cada estación y cada hora traen otros."
modo = 2
asiento = ExtResource("2_asiento")
asiento_frente = ExtResource("3_frente")
orden = 2
rareza_min = 2
rareza_max = 5
profundidad_extra = 3
peso_minimo_especie = 40.0
mult_valor = 0.22
mult_espera = 1.4
